rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Products Collection Security Rules
    match /products/{productId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // Product Shares Collection Security Rules
    match /productShares/{shareToken} {
      allow read: if true;
      allow create, update, delete: if request.auth != null && request.auth.uid == resource.data.createdBy;
    }

    // User-Specific Notifications Security Rules
    match /notifications/{notificationId} {
      // Authenticated users can read only their own notifications
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;

      // Authenticated users can create notifications only for themselves
      allow create: if request.auth != null 
        && request.resource.data.userId == request.auth.uid;

      // Authenticated users can update only their own notifications and cannot change ownership (userId)
      allow update: if request.auth != null 
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId;

      // Authenticated users can delete only their own notifications
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
  }
}
